<Project Sdk="Microsoft.NET.Sdk">

  <!-- BepInEx 6 IL2CPP plugin for GTFO. References come from a BepInEx profile (read-only); override with -p:GTFOBepInExPath=<profile>/BepInEx. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <Version>1.0.0</Version>
    <GTFOBepInExPath Condition="'$(GTFOBepInExPath)' == ''">C:/Users/nainf/AppData/Roaming/r2modmanPlus-local/GTFO/profiles/Forge-Multiplayer/BepInEx</GTFOBepInExPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ForgeSkin.Format\ForgeSkin.Format.csproj" />
    <!-- Ogg Vorbis decoder for skin sounds (MIT, managed); NVorbis.dll ships beside the plugin with licenses/NVorbis.LICENSE. -->
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <Reference Include="$(GTFOBepInExPath)/core/0Harmony.dll" Private="false" />
    <Reference Include="$(GTFOBepInExPath)/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GTFOBepInExPath)/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GTFOBepInExPath)/core/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GTFOBepInExPath)/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GTFOBepInExPath)/interop/*.dll" Exclude="$(GTFOBepInExPath)/interop/netstandard.dll" Private="false" />
  </ItemGroup>

  <!-- A Release build refreshes the committed prebuilt plugin (repo plugin/), which the backend installs on machines
       that cannot build the plugin (no BepInEx interop assemblies). -->
  <Target Name="CopyPrebuilt" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(OutDir)ForgeSkin.Plugin.dll;$(OutDir)ForgeSkin.Format.dll;$(OutDir)NVorbis.dll;licenses/NVorbis.LICENSE"
          DestinationFolder="$(MSBuildThisFileDirectory)../../plugin" SkipUnchangedFiles="true" />
  </Target>

</Project>
